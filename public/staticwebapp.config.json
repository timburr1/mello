{
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/icons/*",
      "/api/*",
      "/favicon.svg",
      "/manifest.webmanifest",
      "/sw.js"
    ]
  },
  "platform": {
    "apiRuntime": "node:22"
  }
}
